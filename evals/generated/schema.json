    "id": {
      "title": "Id",
      "type": "string"
    },
    "intent": {
      "anyOf": [
        {
          "$ref": "#/$defs/Intent"
        },
        {
          "type": "null"
        }
      ]
    },
    "question": {
      "title": "Question",
      "type": "string"
    },
    "rationale": {
      "title": "Rationale",
      "type": "string"
    }
