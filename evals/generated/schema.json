            {
              "enum": [
                "account",
                "region",
                "work_type",
                "technician",
                "incident_type",
                "severity",
                "month",
                "quarter"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Breakdown"
        },
        "examples_requested": {
