# --- Local Postgres (docker-compose) ---
# 127.0.0.1, not localhost: compose publishes Postgres on IPv4 loopback only, and
# localhost resolves to ::1 first on Windows, where the connection hangs instead of failing.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=service_ops
POSTGRES_ADMIN_USER=
POSTGRES_ADMIN_PASSWORD=
# Seconds Alembic, load.py and validate.py wait to connect before failing (default 10).
POSTGRES_CONNECT_TIMEOUT_S=10

# Per-agent least-privilege roles — see docs/data-dictionary.md §7 access matrix
DB_ROLE_REPORTING_USER=
DB_ROLE_REPORTING_PASSWORD=
DB_ROLE_SENTIMENT_USER=
DB_ROLE_SENTIMENT_PASSWORD=
DB_ROLE_FORECAST_USER=
DB_ROLE_FORECAST_PASSWORD=
DB_ROLE_QA_USER=
DB_ROLE_QA_PASSWORD=
DB_ROLE_GENERATOR_USER=
DB_ROLE_GENERATOR_PASSWORD=
# Offline read roles (ADR-063): validation/evaluation and training scripts on the developer
# machine only. Never give these to a deployed service, compose service or Dockerfile.
DB_ROLE_EVAL_USER=
DB_ROLE_EVAL_PASSWORD=
DB_ROLE_TRAIN_USER=
DB_ROLE_TRAIN_PASSWORD=

# --- LLM provider (runtime inference) — see docs/decisions-log.md ADR-006, ADR-029 ---
GOOGLE_AI_API_KEY=
# Separate paid, spend-capped project for Flash-Lite corpus generation and Sprint 5 evals
# (ADR-041). Used by build_corpus.py --paid and by packages/llm only when LLM_MODE=paid
# (ADR-048); the Gemma judge stays on the key above.
GOOGLE_AI_API_KEY_PAID=
GEMINI_MODEL_SPECIALIST=gemini-3.5-flash-lite
# Per-role runtime models (ADR-049): every role on Flash-Lite (free tier 15 RPM, 500 RPD).
GEMINI_MODEL_ORCHESTRATOR=gemini-3.5-flash-lite
GEMINI_MODEL_QA=gemini-3.5-flash-lite

# --- packages/llm client policy (ADR-048) ---
# LLM_MODE: free (default) or paid. Paid is an explicit opt-in and refuses to start
# unless GOOGLE_AI_API_KEY_PAID, LLM_MAX_REQUESTS and LLM_MAX_SPEND_USD are all set.
LLM_MODE=
# Per-process request cap, retries included (free-mode default 1000; required in paid mode).
LLM_MAX_REQUESTS=
# Per-process list-price spend cap in USD (paid mode only; required there).
LLM_MAX_SPEND_USD=
# Total seconds a call may wait on per-minute 429s before LLMRateLimited (default 30).
LLM_MAX_RETRY_WAIT_S=
# Per-request HTTP timeout in seconds (default 30).
LLM_REQUEST_TIMEOUT_S=
# Sampling temperature (default 0.0).
LLM_TEMPERATURE=
# Thinking level override per role. Leave blank: each model's lowest supported level
# (llm/prices.toml; Flash-Lite "minimal", 3.7 Flash "low"). A level the model doesn't
# support is refused, never sent (ADR-052).
LLM_THINKING_LEVEL_ORCHESTRATOR=
LLM_THINKING_LEVEL_SPECIALIST=
LLM_THINKING_LEVEL_QA=

# Optional comparison provider — leave blank unless testing
ANTHROPIC_API_KEY=

# --- GCP (used from Sprint 5 onward — harmless to set now) ---
GCP_PROJECT_ID=
GCP_REGION=

# --- Cost guardrails — see docs/architecture.md §9 ---
MAX_COST_PER_RUN_USD=
MAX_QA_RETRY_ATTEMPTS=2

# --- Services: timeouts and logging (read by docker-compose) ---
# Inside ADR-034's 120 s ceiling: routing (ROUTE_TIMEOUT_S) + the A2A call (A2A_TIMEOUT_S),
# which covers the agent's parse (PARSE_TIMEOUT_S) and MCP call (MCP_TIMEOUT_S), which
# covers the DB statement. 30 + 60 = 90 s worst case.
MCP_DB_STATEMENT_TIMEOUT_MS=10000
MCP_TIMEOUT_S=15
PARSE_TIMEOUT_S=30
ROUTE_TIMEOUT_S=30
A2A_TIMEOUT_S=60
LOG_LEVEL=INFO

# --- Service URLs ---
# Compose sets these itself on its network; set them only when running a service on the
# host (python -m mcp_incidents / agent_reporting / orchestrator serve).
# MCP_INCIDENTS_URL=http://localhost:8101/mcp
# AGENT_REPORTING_PUBLIC_URL=http://localhost:8001/    # advertised in the Agent Card
# AGENT_REPORTING_URL=http://localhost:8001            # where the orchestrator fetches the card
# ORCHESTRATOR_URL=http://localhost:8000               # used by `python -m orchestrator ask`
# Optional overrides; defaults match the loaded dataset (data/generator/parameters.py).
# DATASET_WINDOW_START=2023-09-04
# DATASET_WINDOW_END=2026-08-30
# Relative dates in reporting questions resolve against this, never the wall clock
# (ADR-050). Defaults to DATASET_WINDOW_END.
# REPORTING_AS_OF_DATE=2026-08-30
# Answer text ranks only groups with at least this many cases; the data part keeps every
# group (presentation only, not a metric definition). Default 20.
# REPORTING_MIN_GROUP_DENOMINATOR=20

# --- Service ports (local docker-compose) ---
ORCHESTRATOR_PORT=8000
AGENT_REPORTING_PORT=8001
AGENT_SENTIMENT_PORT=8002
AGENT_FORECAST_PORT=8003
AGENT_QA_PORT=8004
MCP_INCIDENTS_PORT=8101
MCP_FEEDBACK_PORT=8102
MCP_VOLUME_PORT=8103
API_GATEWAY_PORT=8080
