# --- Local Postgres (docker-compose) ---
# 127.0.0.1, not localhost: compose publishes Postgres on IPv4 loopback only, and
# localhost resolves to ::1 first on Windows, where the connection hangs instead of failing.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=service_ops
POSTGRES_ADMIN_USER=
POSTGRES_ADMIN_PASSWORD=
# Seconds Alembic, load.py and validate.py wait to connect before failing (default 10).
POSTGRES_CONNECT_TIMEOUT_S=10

# Per-agent least-privilege roles — see docs/data-dictionary.md §7 access matrix
DB_ROLE_REPORTING_USER=
DB_ROLE_REPORTING_PASSWORD=
DB_ROLE_SENTIMENT_USER=
DB_ROLE_SENTIMENT_PASSWORD=
DB_ROLE_FORECAST_USER=
DB_ROLE_FORECAST_PASSWORD=
DB_ROLE_QA_USER=
DB_ROLE_QA_PASSWORD=
DB_ROLE_GENERATOR_USER=
DB_ROLE_GENERATOR_PASSWORD=

# --- LLM provider (runtime inference) — see docs/decisions-log.md ADR-006, ADR-029 ---
GOOGLE_AI_API_KEY=
# Separate paid, spend-capped project for Flash-Lite corpus generation and Sprint 5 evals
# (ADR-041). Used only by build_corpus.py --paid; the Gemma judge stays on the key above.
GOOGLE_AI_API_KEY_PAID=
GEMINI_MODEL_SPECIALIST=gemini-3.5-flash-lite
GEMINI_MODEL_ORCHESTRATOR=gemini-3.5-flash-lite
GEMINI_MODEL_QA=gemini-3.5-flash-lite

# Optional comparison provider — leave blank unless testing
ANTHROPIC_API_KEY=

# --- GCP (used from Sprint 5 onward — harmless to set now) ---
GCP_PROJECT_ID=
GCP_REGION=

# --- Cost guardrails — see docs/architecture.md §9 ---
MAX_COST_PER_RUN_USD=
MAX_QA_RETRY_ATTEMPTS=2

# --- Walking skeleton: timeouts and logging (read by docker-compose) ---
# Nested inside ADR-034's 120 s end-to-end ceiling: DB statement < MCP call < A2A call.
MCP_DB_STATEMENT_TIMEOUT_MS=10000
MCP_TIMEOUT_S=15
A2A_TIMEOUT_S=30
LOG_LEVEL=INFO

# --- Walking skeleton: service URLs ---
# Compose sets these itself on its network; set them only when running a service on the
# host (python -m mcp_incidents / agent_reporting / orchestrator serve).
# MCP_INCIDENTS_URL=http://localhost:8101/mcp
# AGENT_REPORTING_PUBLIC_URL=http://localhost:8001/    # advertised in the Agent Card
# AGENT_REPORTING_URL=http://localhost:8001            # where the orchestrator fetches the card
# ORCHESTRATOR_URL=http://localhost:8000               # used by `python -m orchestrator ask`
# Optional overrides; defaults match the loaded dataset (data/generator/parameters.py).
# DATASET_WINDOW_START=2023-09-04
# DATASET_WINDOW_END=2026-08-30
# SKELETON_RANGE_START=2026-06-01    # TODO(ADR-046): fixed range until question parsing
# SKELETON_RANGE_END=2026-08-30

# --- Service ports (local docker-compose) ---
ORCHESTRATOR_PORT=8000
AGENT_REPORTING_PORT=8001
AGENT_SENTIMENT_PORT=8002
AGENT_FORECAST_PORT=8003
AGENT_QA_PORT=8004
MCP_INCIDENTS_PORT=8101
MCP_FEEDBACK_PORT=8102
MCP_VOLUME_PORT=8103
API_GATEWAY_PORT=8080
