# Frozen evaluation inputs (Sprint 4 close, ADR-093; found by ADR-092's hash mismatch): LF in every
# checkout, so a file's SHA-256 equals its git blob's bytes on Windows (core.autocrlf) and in CI
# alike. The golden set is named by path only. The specific "-text" lines further down (the hashed
# golden files, splits and manifests) come later and so still win: those stay byte-for-byte.
evals/golden/** text eol=lf
evals/qa_faults/** text eol=lf
evals/qa_interp/*.jsonl text eol=lf
evals/routing/*.jsonl text eol=lf
evals/routing/*.csv text eol=lf
evals/reporting_parse/*.jsonl text eol=lf
evals/forecast_parse/*.jsonl text eol=lf
evals/sentiment_parse/*.jsonl text eol=lf
# Hashed artifacts: stored and checked out byte-for-byte, never line-ending converted,
# so the SHA-256 in a split manifest or the test ledger matches on Windows (core.autocrlf) and in CI alike.
ml/sentiment/splits/*.csv -text
evals/results/sentiment/**/*.predictions.csv -text
# The artifact manifest's SHA-256 is the stored predictions' model_version (ADR-067).
ml/sentiment/artifacts/*.manifest.json -text
ml/forecast/artifacts/*.manifest.json -text
# Golden set v1: the manifest hashes the questions and expected files (ADR-074).
evals/golden/golden_v1.jsonl -text
evals/golden/golden_v1.expected.json -text
evals/golden/golden_v1.manifest.json -text
evals/golden/oracles.py -text
evals/golden/golden_v2.jsonl -text
evals/golden/golden_v2.expected.json -text
evals/golden/golden_v2.manifest.json -text
# Generated evaluation sets (ADR-094): LF in every checkout, so the raw-output hashes in
# provenance.json equal the blob bytes on Windows and in CI alike.
evals/generated/** text eol=lf
# The volume_v2 parameter files are hashed by the manifest and baked into two images (ADR-098):
# stored and checked out byte-for-byte, so the SHA-256 matches on Windows (core.autocrlf) and in CI.
models/forecast/volume_v2/*.json -text

# Prompt files are hashed by the evaluation-freeze test (ADR-103): LF in every checkout.
services/*/prompts/*.md text eol=lf
