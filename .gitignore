# Environment / secrets — .env.example is intentionally re-included
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/

# Node / web
web/node_modules/
web/.next/
web/out/
web/dist/

# Terraform — state files can contain sensitive resource data
infra/terraform/.terraform/
*.tfstate
*.tfstate.backup
*.tfvars

# Trained model artifacts — not source, don't belong in git history
services/*/models/*.bin
services/*/models/*.pt
services/*/models/*.pth
services/*/models/*.safetensors
services/*/models/*.joblib
services/*/models/*.pkl

# Local Postgres data volume (docker-compose)
pgdata/
*.offline.sql

# Logs and coverage
*.log
.coverage
htmlcov/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Claude Code — personal, machine-specific memory, never shared
CLAUDE.local.md
# Corpus build working files: raw responses, stage files, request counts (ADR-036)
data/generator/corpus/work/

# Local copies of versioned model artifacts and training checkpoints (ADR-062, ADR-065).
/models/*
# volume_v2 parameter files are committed and baked into the forecast and QA images (ADR-098):
# small, readable, hash-checked by ml/forecast/artifacts/volume_v2.manifest.json. Nothing else
# under models/ (the sentiment weights in particular) is un-ignored.
!/models/forecast/
/models/forecast/*
!/models/forecast/volume_v2/
/models/forecast/volume_v2/*
!/models/forecast/volume_v2/*.json

# Local gateway state: the invite store (ADR-097). Holds token hashes.
.local/
