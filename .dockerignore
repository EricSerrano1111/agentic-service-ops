# Allowlist: service images build from the repo root but need only the workspace
# definition (pyproject.toml, uv.lock), the shared packages and the services.
# Everything else (pgdata/, .env, .venv/, data/, docs/) stays out of the build context,
# so no secret or database file can be copied into an image.
*
!pyproject.toml
!uv.lock
!packages/
!services/
**/__pycache__
**/*.egg-info
**/tests/
**/.gitkeep
# The committed artifact manifest only (ADR-067): its hash is mcp_feedback's model_version.
!ml/sentiment/artifacts/bert_v1.manifest.json
# The volume_v2 manifest only (ADR-072): mcp_volume verifies the mounted artifact against it.
!ml/forecast/artifacts/volume_v2.manifest.json
# The volume_v2 parameter files (ADR-098): baked into mcp_volume and agent_qa, hash-checked
# against the manifest at start-up. Nothing else under models/ (the sentiment weights stay out).
!models/forecast/volume_v2/*.json
# The `!services/` and `!packages/` re-includes above pull in everything beneath them, so
# secret-shaped files nested there are excluded explicitly.
**/.env
**/.env.*
**/*.pem
**/*.key
**/*credentials*.json
**/*service-account*.json

# The UI source for the gateway image, which builds the export itself (ADR-080).
!web/
web/node_modules/
web/.next/
web/out/
